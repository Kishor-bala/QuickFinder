# ============================================================
# QUICK FINDER — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# 1. Copy this file and rename it to: .env
# 2. Fill in your own values where indicated
# 3. Place the .env file in the ROOT of the project (next to package.json)
# 4. Run: npm install && npm run dev
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# --- OTP via 2Factor.in (Phone Verification) ---
# Sign up free at https://2factor.in and get your API key from:
# https://2factor.in/v3/account/api-keys
TWO_FACTOR_API_KEY=your_2factor_api_key_here

# --- Firebase Web SDK (Frontend) ---
# Get these from Firebase Console → Project Settings → Your Apps → Web App
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- Firebase Admin SDK (Backend) ---
# Place your firebase-service-account.json in: apps/api/src/config/
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
# (No env var needed — just place the JSON file in the folder above)
