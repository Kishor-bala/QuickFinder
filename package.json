{
  "name": "quick-finder-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Quick Finder - Production-Grade Lost & Found Management Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "npm run dev --prefix apps/api",
    "dev:web": "npm run dev --prefix apps/web",
    "build": "npm run build --prefix apps/web",
    "test": "npm run test --prefix apps/api",
    "db:seed": "npm run seed --prefix apps/api",
    "db:clear": "npm run clear-db --prefix apps/api",
    "lint": "npm run lint --prefix apps/web"
  },
  "keywords": [
    "monorepo",
    "lost-and-found",
    "production-architecture",
    "express",
    "react",
    "vite",
    "sqlite"
  ],
  "author": "Quick Finder Team",
  "license": "ISC"
}
